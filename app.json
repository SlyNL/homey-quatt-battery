          "title": {
            "en": "Solar savings",
            "nl": "Zonnepaneelbesparing"
          }
        },
        "quatt_savings_imbalance": {
          "title": {
            "en": "Imbalance savings",
            "nl": "Onbalansbesparing"
          }
        },
        "quatt_savings_battery_yesterday": {
          "title": {
