{
  "id": "io.quatt.battery",
  "version": "1.0.22",
  "compatibility": ">=12.1.0",
  "sdk": 3,
  "name": {
    "en": "Quatt Home Battery",
    "nl": "Quatt Thuisbatterij"
  },
  "description": {
    "en": "Track, automate and maximise savings from your Quatt Home Battery.",
    "nl": "Houd je Quatt Thuisbatterij bij, automatiseer en maximaliseer je besparing."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "brandColor": "#1a2b3c",
  "author": {
    "name": "SlyNL",
    "email": "SlyNL@users.noreply.github.com"
  },
  "drivers": [
    {
      "id": "quatt_home_battery",
      "name": {
        "en": "Quatt Home Battery",
        "nl": "Quatt Thuisbatterij"
      },
      "class": "battery",
      "capabilities": [
        "measure_battery",
        "measure_power",
        "meter_power.charged",
        "meter_power.discharged",
        "quatt_power_flow_direction",
        "quatt_control_action",
        "quatt_savings_yesterday",
        "quatt_capacity_kwh",
        "quatt_savings_total",
        "quatt_control_mode",
        "quatt_inverter_power_kw",
